[Interface]
Address = 10.8.0.1/24
MTU = 1280
ListenPort = 1194
PrivateKey = (HIDDEN)
PostUp = sysctl -w net.ipv4.ip_forward=1; ufw allow 1194/udp; iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE
PostDown = sysctl -w net.ipv4.ip_forward=0; ufw delete allow 1194/udp; iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE

[Peer]
# tobi_trb256_e2plus
PublicKey = (PEER_PUBKEY)
AllowedIPs = 10.8.0.2/32, 192.168.0.0/24
